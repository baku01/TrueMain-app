    <!-- Pairing -->
    <string name="connect_title">Control League from your phone</string>
    <string name="connect_body">Queue, accept the match, pick, ban and set your runes while away from the keyboard. Your phone talks to the TrueMain app on your computer, over your Wi-Fi only.</string>
    <string name="connect_step1">On your computer, open TrueMain → Settings → Phone and turn it on.</string>
    <string name="connect_step2">Click “Pair a phone” to show a QR code.</string>
    <string name="connect_step3">Scan it here, with your phone on the same Wi-Fi.</string>
    <string name="connect_scan">Scan the QR code</string>
    <string name="connect_paste">Or paste the pairing link</string>
