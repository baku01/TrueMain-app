    <string name="connect_title">Controle o League pelo celular</string>
    <string name="connect_body">Entre na fila, aceite a partida, escolha, bana e monte suas runas longe do teclado. O celular conversa com o app TrueMain do seu computador, só pelo seu Wi-Fi.</string>
    <string name="connect_step1">No computador, abra o TrueMain → Configurações → Celular e ative.</string>
    <string name="connect_step2">Clique em “Parear um celular” para mostrar um QR code.</string>
