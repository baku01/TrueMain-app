{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TrueMain",
  "version": "0.5.0",
  "identifier": "gg.truemain.desktop",
  "build": {
    "frontendDist": "../app/.output/public",
    "devUrl": "http://localhost:3003",
    "beforeDevCommand": "npm run dev --prefix ../app",
    "beforeBuildCommand": "npm run generate --prefix ../app"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "TrueMain",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "maximizable": true,
        "visible": false,
        "decorations": true,
        "dragDropEnabled": false,
        "theme": "Dark",
        "backgroundColor": "#131a27"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; img-src 'self' https://ddragon.leagueoflegends.com https://raw.communitydragon.org https://cmsassets.rgpub.io https://blitz-cdn.blitz.gg https://opgg-static.akamaized.net https://d28xe8vt774jo5.cloudfront.net data:; media-src 'self' https://d28xe8vt774jo5.cloudfront.net https://blitz-cdn-videos.blitz.gg; connect-src 'self' https://ddragon.leagueoflegends.com https://raw.communitydragon.org; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.3",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBGQzM2NjJFQUFCMDk2OTMKUldTVGxyQ3FMbWJERDhHZHB5ck5xN0JISFRqd0RpWlk2dVRRR0ZmTFBxancyd0J2OTBiMlpmVWUK",
      "endpoints": [
        "https://github.com/baku01/TrueMain-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
